{
  "name": "algorithm-stories",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node --import tsx scripts/build-figures.mjs && astro check && astro build",
    "build:figures": "node --import tsx scripts/build-figures.mjs",
    "preview": "astro preview",
    "lint": "biome check . && astro check",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "test:visual": "playwright test tests/e2e/visual.spec.ts",
    "check:links": "node scripts/check-links.mjs",
    "check:citations": "node scripts/check-citations.mjs",
    "capture:runtime": "node scripts/capture-runtime.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "lighthouse": "lhci autorun && lhci autorun --config=lighthouserc.mobile.json",
    "deploy": "pnpm build && wrangler deploy",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.6",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.1.2",
    "astro": "^7.4.4",
    "d3-color": "^3.1.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "svelte": "^5.57.3"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@types/d3-color": "^3.1.3",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "web-vitals": "^6.2.3",
    "wrangler": "^4.155.0"
  }
}
