---
/**
 * Public story page layout.
 *
 * BaseLayout owns the document head and `Seo`; this layout adds the editorial
 * header that belongs to a story entry: title, dek, category/difficulty,
 * learning objectives, and prerequisites. The story itself arrives through the
 * slot, so the server-rendered article is the default and the interactive stage
 * remains an enhancement owned by the page.
 */

import type { CollectionEntry } from 'astro:content';
// KaTeX's stylesheet and self-hosted fonts are only needed on story routes.
// Importing it here keeps the home/index pages free of that CSS while the
// build emits the font files as same-origin hashed assets under `/_astro/`.
import 'katex/dist/katex.min.css';
import BaseLayout from './BaseLayout.astro';

export interface Props {
  entry: CollectionEntry<'stories'>;
}

const { entry } = Astro.props;
const {
  title,
  dek,
  category,
  difficulty,
  difficultyNote,
  learningObjectives,
  prerequisites,
} = entry.data;
---

<BaseLayout title={title} description={dek} type="article">
  <div class="story-page page-shell" data-story-page={entry.data.slug}>
    <header class="story-page__header" data-story-header>
      <p class="eyebrow story-page__kicker">
        {category} <span aria-hidden="true">·</span> {difficulty}
      </p>
      <h1 class="story-page__title">{title}</h1>
      <p class="story-page__dek">{dek}</p>
      {difficultyNote && <p class="story-page__difficulty-note">{difficultyNote}</p>}

      <div class="story-page__brief">
        <section class="story-page__brief-block" aria-labelledby="story-objectives-title">
          <h2 class="story-page__brief-title" id="story-objectives-title">What you will learn</h2>
          <ul class="story-page__list">
            {learningObjectives.map((objective) => <li>{objective}</li>)}
          </ul>
        </section>

        <section class="story-page__brief-block" aria-labelledby="story-prerequisites-title">
          <h2 class="story-page__brief-title" id="story-prerequisites-title">Before you start</h2>
          <ul class="story-page__list">
            {prerequisites.map((prerequisite) => <li>{prerequisite}</li>)}
          </ul>
        </section>
      </div>
    </header>

    <slot />
  </div>
</BaseLayout>

<style>
  .story-page {
    padding-block: clamp(var(--space-2xl), 8vw, var(--space-5xl)) var(--space-3xl);
  }

  .story-page__header {
    max-inline-size: var(--measure-prose);
    padding-block-end: var(--space-2xl);
  }

  .story-page__kicker {
    margin: 0;
  }

  .story-page__title {
    margin-block: var(--space-sm) 0;
    font-size: var(--text-h1);
    line-height: var(--leading-none);
    letter-spacing: var(--tracking-tighter);
  }

  .story-page__dek {
    margin-block-start: var(--space-md);
    color: var(--color-paper-muted);
    font-family: var(--font-display);
    font-size: var(--text-lead);
    line-height: var(--leading-snug);
  }

  .story-page__difficulty-note {
    margin-block-start: var(--space-xs);
    color: var(--color-paper-muted);
    font-size: var(--text-sm);
  }

  .story-page__brief {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-lg);
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-md);
    border-block-start: var(--hairline) solid var(--color-rule-paper);
  }

  .story-page__brief-title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }

  .story-page__list {
    display: grid;
    gap: var(--space-3xs);
    margin: var(--space-2xs) 0 0;
    padding-inline-start: var(--space-md);
    color: var(--color-paper-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  @media (max-width: 40rem) {
    .story-page {
      padding-block-start: var(--space-xl);
    }
  }
</style>
