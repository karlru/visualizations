---
/**
 * Static figure with an editorial caption and a source note.
 *
 * The drawing is supplied as trusted, build-time SVG markup (for the ACO story,
 * generated by `scripts/build-figures.mjs`). Inlining it keeps the figure part
 * of the server-rendered article: it is present with JavaScript disabled, it
 * scales with the page, and it inherits the design tokens declared on `:root`.
 * The component adds no client script.
 *
 * The SVG carries its own `<title>` and `<desc>`, so the frame is not labelled a
 * second time; the caption supplies the readable argument and the numbers. On
 * narrow screens the drawing's internal annotations would shrink below a
 * readable size, so they are hidden and the caption carries their content. The
 * drawing itself stays full width, with no horizontal page overflow.
 */

interface Props {
  /** Trusted SVG source, imported with Vite's `?raw` suffix. */
  svg: string;
  /** Short lead-in for the caption. */
  title: string;
  /** The caption proper: what to look at and what it means. */
  caption: string;
  /** Provenance note; says where the drawing came from. */
  source?: string;
  /** Optional stable id. */
  id?: string;
  /** Stable name used by tests and deep links; rendered as `data-figure`. */
  name?: string;
}

const { svg, title, caption, source, id, name } = Astro.props;
---

<figure class="figure" id={id} data-figure={name}>
  <div class="figure__frame" set:html={svg} />
  <figcaption class="figure__caption">
    <span class="figure__lead">{title}</span>{' '}
    <span class="figure__text">{caption}</span>
    {source && <span class="figure__source">{source}</span>}
  </figcaption>
</figure>

<style>
  .figure {
    display: grid;
    gap: var(--space-xs);
    margin-block: var(--space-lg);
  }

  .figure__frame {
    overflow: hidden;
    border: var(--hairline) solid var(--color-rule-paper);
    border-radius: var(--radius-md);
    background-color: var(--color-paper-inset);
  }

  .figure__frame :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  /*
   * The 960 × 600 drawing's labels are ~15 px at full size; below the prose
   * breakpoint they would render at four or five pixels. Hide only the text
   * nodes there. The route, halo, dash pattern, and square markers stay
   * visible, and the caption repeats every number the labels carried.
   */
  @media (max-width: 48rem) {
    .figure__frame :global(svg text) {
      display: none;
    }
  }

  .figure__caption {
    color: var(--color-paper-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .figure__lead {
    color: var(--color-ink);
    font-weight: var(--weight-semibold);
  }

  .figure__source {
    display: block;
    margin-block-start: var(--space-3xs);
    color: var(--color-paper-muted);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-tight);
  }
</style>
