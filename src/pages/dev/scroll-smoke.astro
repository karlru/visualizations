---
import StoryController from '../../components/story/StoryController.svelte';
import BaseLayout from '../../layouts/BaseLayout.astro';

const chapters = [
  {
    id: 'chapter-1',
    title: 'The pheromone field',
    body:
      'The stage placeholder occupies the sticky column while the prose scrolls past. Nothing here owns simulation time: the ScrollDirector reports which chapter is active and how far through it the reader has travelled.',
  },
  {
    id: 'chapter-2',
    title: 'The transition rule',
    body:
      'Each chapter has a stable id and a tall block so entry, progress, and exit are easy to observe. Scroll quickly, scroll backwards, or jump with the keyboard; the report must stay coherent.',
  },
  {
    id: 'chapter-3',
    title: 'Evaporation',
    body:
      'On a desktop with motion allowed, Lenis smooths wheel input and is driven by the GSAP ticker. Under reduced motion, on a coarse pointer, or with ?lenis=off, the director keeps native scrolling and never starts a second RAF loop.',
  },
  {
    id: 'chapter-4',
    title: 'Emergence',
    body:
      'This page exists only to exercise the runtime in the built preview. It is noindex, absent from the sitemap, and never linked from the public navigation.',
  },
];

const facts = [
  ['scroller', 'document'],
  ['scrollbar', 'native'],
  ['driver', 'gsap.ticker'],
  ['test mode', '?lenis=off'],
];
---

<BaseLayout
  title="Scroll director smoke test"
  description="Internal scroll-runtime fixture for the Algorithm Stories ScrollDirector and Lenis policy."
  noindex
>
  <div class="scroll-smoke page-shell">
    <header class="scroll-smoke__intro">
      <p class="eyebrow">Internal · not indexed</p>
      <h1 class="scroll-smoke__title">Scroll director smoke test</h1>
      <p class="scroll-smoke__dek">
        Four tall chapters and a sticky stage placeholder. The dev overlay reports the active
        chapter, progress, Lenis state, and the last callback. Append
        <code>?lenis=off</code> to force test mode; add <code>?debug=1</code> if you land here without
        the debug prop.
      </p>
    </header>

    <div class="story-layout" data-scroll-story>
      <div class="story-layout__stage">
        <div class="stage story-stage">
          <div class="stage__surface story-stage__surface">
            <p class="eyebrow">Stage placeholder · sticky</p>
            <p class="story-stage__readout">scroll-smoke</p>
            <p class="story-stage__caption">
              Step 1.4 replaces this panel with the Canvas 2D stage. For now it proves that a
              sticky presentation surface and native document scrolling coexist.
            </p>
            <dl class="story-stage__facts">
              {
                facts.map(([label, value]) => (
                  <div class="story-stage__fact">
                    <dt>{label}</dt>
                    <dd class="data">{value}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>
      </div>

      <div class="story-layout__chapters">
        {
          chapters.map((chapter, index) => (
            <section
              id={chapter.id}
              class="story-chapter"
              data-story-chapter
              aria-labelledby={`${chapter.id}-title`}
            >
              <p class="story-chapter__index">Chapter {String(index + 1).padStart(2, '0')}</p>
              <h2 id={`${chapter.id}-title`} class="story-chapter__title">
                {chapter.title}
              </h2>
              <p class="story-chapter__body">{chapter.body}</p>
              <p class="story-chapter__body">
                Scroll a little, then a little more: the overlay progress should advance without a
                page reload. The stage never changes the document scroller, so the scrollbar,
                PageDown, PageUp, arrows, Home, and End all keep working.
              </p>
            </section>
          ))
        }
      </div>
    </div>

    <section class="scroll-smoke__outro" aria-labelledby="outro-title">
      <p class="eyebrow">End of fixture</p>
      <h2 id="outro-title" class="scroll-smoke__outro-title">Native scroll to the end</h2>
      <p class="scroll-chapter__body">
        This block gives the document extra length so Home and End have unambiguous extremes. The
        development harness stays in the build as the scroll test fixture until Step 1.5 replaces it
        with <code>/dev/story-smoke</code>.
      </p>
      <p><a href="/">Back to the home page</a></p>
    </section>
  </div>

  <StoryController client:load debug chapterSelector="[data-story-chapter]" />
</BaseLayout>

<style>
  .scroll-smoke {
    padding-block: var(--space-2xl) var(--space-3xl);
  }

  .scroll-smoke__intro {
    max-inline-size: var(--measure-prose);
    padding-block-end: var(--space-2xl);
  }

  .scroll-smoke__title {
    margin-block-start: var(--space-sm);
    font-size: var(--text-h1);
    letter-spacing: var(--tracking-tighter);
  }

  .scroll-smoke__dek {
    margin-block-start: var(--space-md);
    color: var(--color-paper-muted);
    font-size: var(--text-lead);
    line-height: var(--leading-relaxed);
  }

  .story-stage__caption {
    max-inline-size: var(--measure-narrow);
    color: var(--color-stage-muted);
    line-height: var(--leading-relaxed);
  }

  .story-stage__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xs) var(--space-md);
    margin-block-start: var(--space-sm);
    padding-block-start: var(--space-sm);
    border-block-start: var(--hairline) solid var(--color-rule-stage);
  }

  .story-stage__fact {
    display: grid;
    gap: var(--space-3xs);
  }

  .story-stage__fact dt {
    color: var(--color-stage-muted);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }

  .story-stage__fact dd {
    margin: 0;
    font-size: var(--text-sm);
  }

  .scroll-smoke__outro {
    max-inline-size: var(--measure-prose);
    padding-block: var(--space-3xl) var(--space-2xl);
    border-block-start: var(--hairline) solid var(--color-rule-paper);
  }

  .scroll-smoke__outro-title {
    margin-block: var(--space-sm) var(--space-md);
    font-size: var(--text-h2);
  }

  .scroll-smoke__outro p + p {
    margin-block-start: var(--space-md);
  }

  @media (max-width: 40rem) {
    .story-stage__facts {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
